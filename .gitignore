# ─── Build output ───────────────────────────
target/
*.jar
*.war
*.class

# ─── Secrets — NEVER commit these ───────────
.env

# Hand-made backups of env files (.env.bak, .env.local.bak.<lan-ip>, …) — same secrets,
# not covered by the rules above.
.env*.bak*
*.env.bak*
*.pem
*.key
*.p12
*.jks

# ─── IDE files ───────────────────────────────
.idea/
*.iml
.vscode/
*.classpath
*.project
.settings/

# ─── OS files ────────────────────────────────
.DS_Store
Thumbs.db

# ─── Local image uploads (dev only) ─────────
uploads/

# ─── Logs ────────────────────────────────────
logs/
*.log

# ─── Maven wrapper cache ─────────────────────
.mvn/wrapper/maven-wrapper.jar
